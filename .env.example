NODE_ENV=development
PORT=3001

# Banco (PostgreSQL). Em produção vem do Render (fromDatabase).
DATABASE_URL=postgresql://global7:global7@localhost:5432/global7

# JWT — gere segredos fortes: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-em-producao
JWT_REFRESH_SECRET=troque-outro-diferente
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS — domínio do front (ex.: https://global7-web.onrender.com). Em dev, *
CORS_ORIGIN=*
APP_URL=http://localhost:3001

# Admin inicial (seed). SEED_ON_BOOT=true cria o 1º admin da Global 7 no boot.
SEED_ON_BOOT=false
[email protected]
ADMIN_PASSWORD=troque-em-producao

# ─── Storage das fotos (originais) ───
# STORAGE_DRIVER: "wordpress" | "gdrive" | vazio (auto: WP se WP_* setado; senão Drive; senão LocalDisk).
STORAGE_DRIVER=wordpress

# WordPress (Biblioteca de Mídia via REST). App Password: WP Admin → Usuários → Perfil → Senhas de aplicativo.
WP_BASE_URL=https://seusite.com
WP_USER=
WP_APP_PASSWORD=

# Google Drive (OAuth2) — alternativa. Ver scripts/get-drive-refresh-token.mjs.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Disco local (fallback/dev quando não usa storage externo).
UPLOADS_DIR=./uploads
